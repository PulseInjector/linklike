{
  "source": {
    "repo": "https://github.com/devdotfast/review",
    "commit": "ad457e726d04e3f92e1f751bd4bb9ab28c5d514a",
    "file": "packages/progressive-review/app/src/styles.css",
    "selectors": [
      ".review-document",
      ".review-document h1",
      ".review-document h2",
      ".review-document h3",
      ".review-document p",
      ".review-document li",
      ".review-document code",
      ".review-document pre"
    ],
    "note": "Body serif stack, heading/paragraph/list measure, and code rules from .review-document. Fallback literals from .review-canvas-root (not vscode theme vars)."
  },
  "font": {
    "serif": "Newsreader, Georgia, serif",
    "mono": "Geist Mono, ui-monospace, monospace"
  },
  "color": {
    "ink": "#e8eaee",
    "inkRgb": "rgb(232, 234, 238)",
    "background": "#0a0b0d",
    "backgroundRgb": "rgb(10, 11, 13)",
    "codeBackground": "#10141c",
    "codeBackgroundRgb": "rgb(16, 20, 28)",
    "preBackground": "#0d0f13",
    "preBackgroundRgb": "rgb(13, 15, 19)",
    "preBorder": "#1c1f26",
    "preBorderRgb": "rgb(28, 31, 38)",
    "link": "#4d6ef5",
    "linkRgb": "rgb(77, 110, 245)"
  },
  "document": {
    "fontSize": "15px",
    "lineHeight": "1.72",
    "lineHeightPx": "25.8px",
    "maxWidth": "860px",
    "measure": "720px"
  },
  "h1": {
    "fontSize": "34px",
    "fontWeight": "500",
    "lineHeight": "40px",
    "margin": "0 auto 18px"
  },
  "h2": {
    "fontSize": "22px",
    "fontWeight": "500",
    "lineHeight": "28px",
    "margin": "40px auto 12px"
  },
  "h3": {
    "fontSize": "17px",
    "fontWeight": "600",
    "lineHeight": "23px",
    "margin": "30px auto 10px"
  },
  "paragraph": {
    "fontSize": "15px",
    "lineHeight": "1.72",
    "margin": "14px 0"
  },
  "list": {
    "fontSize": "15px",
    "lineHeight": "1.72",
    "itemGap": "8px"
  },
  "code": {
    "fontSize": "0.9em",
    "padding": "2px 5px",
    "borderRadius": "3px"
  },
  "pre": {
    "fontSize": "13px",
    "lineHeight": "1.65",
    "padding": "14px 16px",
    "marginBlock": "24px",
    "borderRadius": "8px"
  }
}
