{
  "source": {
    "repo": "https://github.com/devdotfast/review",
    "commit": "ad457e726d04e3f92e1f751bd4bb9ab28c5d514a",
    "file": "packages/progressive-review/app/src/styles.css",
    "selectors": [
      ".review-document",
      ".review-document h1",
      ".review-document h2",
      ".review-document h3",
      ".review-document p",
      ".review-document li",
      ".review-document code",
      ".review-document pre",
      ".review-app--theme-light"
    ],
    "note": "Body serif stack, heading/paragraph/list measure, and code rules from .review-document. Neutral fallbacks from .review-app--theme-light (not vscode theme vars)."
  },
  "font": {
    "serif": "Newsreader, Georgia, serif",
    "mono": "Geist Mono, ui-monospace, monospace"
  },
  "color": {
    "ink": "#1a1a18",
    "inkRgb": "rgb(26, 26, 24)",
    "background": "#ffffff",
    "backgroundRgb": "rgb(255, 255, 255)",
    "codeBackground": "#f4f4f3",
    "codeBackgroundRgb": "rgb(244, 244, 243)",
    "preBackground": "#ffffff",
    "preBackgroundRgb": "rgb(255, 255, 255)",
    "preBorder": "#e0e0de",
    "preBorderRgb": "rgb(224, 224, 222)",
    "link": "#2b4fe0",
    "linkRgb": "rgb(43, 79, 224)"
  },
  "document": {
    "fontSize": "15px",
    "lineHeight": "1.72",
    "lineHeightPx": "25.8px",
    "maxWidth": "860px",
    "measure": "720px"
  },
  "h1": {
    "fontSize": "34px",
    "fontWeight": "500",
    "lineHeight": "40px",
    "margin": "0 auto 18px"
  },
  "h2": {
    "fontSize": "22px",
    "fontWeight": "500",
    "lineHeight": "28px",
    "margin": "40px auto 12px"
  },
  "h3": {
    "fontSize": "17px",
    "fontWeight": "600",
    "lineHeight": "23px",
    "margin": "30px auto 10px"
  },
  "paragraph": {
    "fontSize": "15px",
    "lineHeight": "1.72",
    "margin": "14px 0"
  },
  "list": {
    "fontSize": "15px",
    "lineHeight": "1.72",
    "itemGap": "8px"
  },
  "code": {
    "fontSize": "0.9em",
    "padding": "2px 5px",
    "borderRadius": "3px"
  },
  "pre": {
    "fontSize": "13px",
    "lineHeight": "1.65",
    "padding": "14px 16px",
    "marginBlock": "24px",
    "borderRadius": "8px"
  }
}
